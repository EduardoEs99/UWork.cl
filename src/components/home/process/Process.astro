---
import ProcessStep from "./ProcessStep.astro";
import { Button } from "@/components/ui/button";
import { steps } from "./steps";
---

<section
  id="como-funciona"
  aria-labelledby="process-heading"
  class="bg-white px-4 py-12 sm:px-6 lg:px-8 lg:py-20"
>
  <div
    class="mx-auto grid max-w-7xl gap-10 px-5 py-10 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:px-12 lg:py-16"
  >
    <div class="process-intro self-start">
      <h2
        id="process-heading"
        class="max-w-lg text-3xl leading-section font-semibold tracking-tight text-brand-petroleum md:text-4xl lg:text-5xl"
      >
        De tu necesidad al estudiante ideal,
        <span class="mt-3 block font-normal italic">en pocos pasos.</span>
      </h2>
      <nav aria-label="Etapas del proceso" class="mt-8 flex flex-wrap gap-3">
        {
          steps.map((item, index) => (
            <button
              type="button"
              data-process-step={index}
              data-complete={index === 0}
              aria-label={"Ir al paso " + (index + 1) + ": " + item[0]}
              aria-controls={"process-step-" + index}
              aria-current={index === 0 ? "step" : undefined}
              class="flex size-10 items-center justify-center rounded-full border border-brand-border bg-white text-sm font-semibold text-brand-petroleum transition-all duration-300 hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-petroleum step-complete:border-brand-mint step-complete:bg-brand-mint current-step:ring-4 current-step:ring-brand-soft motion-reduce:transition-none"
            >
              {index + 1}
            </button>
          ))
        }
      </nav>
      <p
        data-process-caption
        aria-live="polite"
        aria-atomic="true"
        class="mt-5 text-xs text-brand-gray"
      >
        Paso 1 de {steps.length}
      </p>
    </div>
    <div class="process-timeline relative">
      <div
        aria-hidden="true"
        class="process-line absolute left-2 w-0.5 bg-brand-soft"
      >
        <div
          data-process-progress
          class="w-full bg-brand-mint transition-height duration-300 motion-reduce:transition-none"
          style="height: 0%"
        >
        </div>
      </div>
      <ol class="relative flex flex-col gap-10 sm:gap-12 lg:gap-20">
        {steps.map((_, step) => <ProcessStep step={step} />)}
      </ol>
      <div class="mt-8 pl-9">
        <Button nativeNavigation href="#business-contact">
          Publica tu primera oferta
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    --process-pin-top: clamp(8rem, 32svh, 18rem);
  }
  @media (min-width: 1024px) {
    .process-intro {
      position: sticky;
      top: var(--process-pin-top);
    }
    .process-timeline {
      padding-top: 6rem;
    }
  }
  .process-line {
    top: var(--process-line-top, 4rem);
    height: var(--process-line-height, calc(100% - 8rem));
  }
  .process-timeline :global([data-process-illustration]),
  .process-timeline :global([data-process-copy]) {
    opacity: 0.7;
    transition: opacity 650ms ease;
  }
  .process-timeline :global([data-complete="true"] [data-process-illustration]),
  .process-timeline :global([data-complete="true"] [data-process-copy]) {
    opacity: 1;
  }
  .process-timeline
    :global(
      [data-process-row][data-active="true"] [data-process-illustration]
    ) {
    animation: enter 750ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .process-timeline :global([data-process-illustration]),
    .process-timeline :global([data-process-copy]) {
      transition: none;
    }
    .process-timeline :global([data-process-illustration]) {
      animation: none !important;
    }
  }
</style>

<script>
  import "./process.js";
</script>
