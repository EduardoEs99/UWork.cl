---
import { image } from "@/lib/assets";
interface Props {
  name: string;
  file: string;
}
const { name, file } = Astro.props;
---

<div class="flex aspect-200/76 w-full items-center justify-center rounded-2xl border-2 border-black bg-white px-3 py-2">
  <picture class="flex size-full items-center justify-center">
    <source
      srcset={`${image(`webp/brands/${file}.small.webp`)} 300w, ${image(`webp/brands/${file}.webp`)} 600w`}
      sizes="(min-width: 1024px) 150px, (min-width: 640px) 25vw, 35vw"
      type="image/webp"
    />
    <img
      src={image(`png/brands/${file}.png`)}
      alt={name}
      width="600"
      height="255"
      loading="lazy"
      decoding="async"
      class="h-auto max-h-full w-5/6 object-contain"
    />
  </picture>
</div>
