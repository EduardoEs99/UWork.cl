---
import { image as imageUrl } from "@/lib/assets";
import instagramIcon from "@/assets/img/icons/instagram.svg?raw";
import tiktokIcon from "@/assets/img/icons/tiktok.svg?raw";
import linkedinIcon from "@/assets/img/icons/linkedin.svg?raw";

const homeUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const studentsUrl = homeUrl + "estudiantes/";

const contacts = [
  {
    title: "Instagram",
    detail: "@uworkcl",
    href: "https://www.instagram.com/uworkcl/",
    icon: instagramIcon,
    external: true,
    hoverClass:
      "group-hover:text-social-instagram group-focus-visible:text-social-instagram",
  },
  {
    title: "LinkedIn",
    detail: "Enlace por confirmar",
    href: undefined,
    icon: linkedinIcon,
    external: false,
    hoverClass:
      "group-hover:text-social-linkedin group-focus-visible:text-social-linkedin",
  },
  {
    title: "TikTok",
    detail: "Enlace por confirmar",
    href: undefined,
    icon: tiktokIcon,
    external: false,
    hoverClass:
      "group-hover:text-social-tiktok group-focus-visible:text-social-tiktok",
  },
];
---

<footer
  class="bg-brand-petroleum px-6 pt-13.75 pb-6.25 text-brand-soft md:px-page-gutter"
>
  <div class="grid grid-cols-2 gap-5.5 md:grid-cols-footer md:gap-11.25">
    <div
      class="col-span-full flex flex-row items-center gap-6.25 md:col-span-1 md:flex-col md:items-start md:gap-3"
    >
      <img
        src={imageUrl("logos/logo-light.svg")}
        alt="UWork"
        width="120"
        height="40"
        decoding="async"
      />
      <p class="text-xs leading-relaxed">
        Conectamos estudiantes de educación superior con trabajos a su medida.
      </p>
    </div>
    <div>
      <h3 class="mt-3 mb-4.5 text-fine font-semibold text-white md:text-xs">
        NAVEGACIÓN
      </h3>
      <a
        class="mb-2.5 block text-fine md:text-xs hover:underline"
        href={homeUrl + "#como-funciona"}
      >
        ¿Cómo funciona?
      </a>
      <a
        class="mb-2.5 block text-fine md:text-xs hover:underline"
        href={homeUrl + "#empresas"}
      >
        Soy Empresa
      </a>
      <a
        class="mb-2.5 block text-fine md:text-xs hover:underline"
        href={homeUrl + "#personas"}
      >
        Soy Persona
      </a>
      <a
        class="mb-2.5 block text-fine md:text-xs hover:underline"
        href={studentsUrl}
      >
        Soy Estudiante
      </a>
      <a class="mb-2.5 block text-fine md:text-xs hover:underline" href="#">
        Sobre nosotros
      </a>
    </div>
    <div>
      <h3 class="mt-3 mb-4.5 text-fine font-semibold text-white md:text-xs">
        LEGAL
      </h3>
      <span class="mb-2.5 block text-xs">
        Términos y condiciones [por confirmar]
      </span>
      <span class="block text-xs">Política de privacidad [por confirmar]</span>
    </div>
    <div>
      <h3 class="mt-3 mb-4.5 text-fine font-semibold text-white md:text-xs">
        CONTACTO
      </h3>
      <ul class="flex flex-col gap-4">
        {
          contacts.map((contact) => (
            <li>
              <a
                class="group flex items-start gap-3 rounded-sm"
                href={contact.href}
                target={contact.external ? "_blank" : undefined}
                rel={contact.external ? "noopener noreferrer" : undefined}
              >
                <span
                  class:list={[
                    "mt-0.5 shrink-0 text-white transition-colors duration-200",
                    contact.hoverClass,
                  ]}
                >
                  <Fragment set:html={contact.icon} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-semibold text-white">
                    {contact.title}
                  </span>
                  <span class="mt-1 block text-xs leading-relaxed text-brand-soft wrap-break-word">
                    {contact.detail}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div
    class="mt-10 flex flex-col justify-between gap-2.5 border-t border-white/20 pt-5.5 text-2xs text-brand-soft md:flex-row md:gap-5"
  >
    <span class="leading-copy">
      © 2026 UWork. Todos los derechos reservados.
    </span>
    <span class="leading-copy">
      Horario: [Lun a Vie, 9:00 a 18:00 · por confirmar]
    </span>
  </div>
</footer>
