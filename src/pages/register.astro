---
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Check, LoaderCircle } from "lucide-react";
import { image as imageUrl } from "@/lib/assets";
import { routes } from "@/lib/routes";
import AuthLayout from "@/layouts/AuthLayout.astro";

const homeUrl = routes.home;
const loginUrl = routes.login;
---

<AuthLayout
  title="Registro de estudiante"
  description="Crea tu perfil de estudiante para encontrar trabajos que se adapten a tu ritmo."
>
  <section class="px-4 py-6 sm:px-6 md:px-8 md:py-8">
    <div class="mx-auto grid max-w-6xl overflow-hidden rounded-section shadow-brand-header md:min-h-168 md:grid-cols-2">
      <aside class="relative flex min-h-64 flex-col justify-between overflow-hidden bg-linear-to-br from-brand-petroleum via-brand-petroleum to-brand-hover p-7 text-white sm:p-10 md:p-12">
        <a href={homeUrl} aria-label="UWork inicio" class="relative z-10 w-fit">
          <img
            class="w-32"
            src={imageUrl("logos/logo-light.svg")}
            alt="UWork"
            width="120"
            height="40"
          />
        </a>
        <div class="relative z-10 mt-10 max-w-md">
          <p class="text-xs font-medium tracking-kicker text-brand-mint">
            SOY ESTUDIANTE
          </p>
          <h2 class="mt-3 text-3xl leading-tight font-bold">
            Gana plata sin dejar de estudiar
          </h2>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/85">
            Estudia, trabaja y suma experiencia a tu ritmo.
          </p>
        </div>
        <div
          aria-hidden="true"
          class="absolute -right-24 -bottom-28 size-80 rounded-full border border-white/15"
        ></div>
        <div
          aria-hidden="true"
          class="absolute -right-12 -bottom-16 size-56 rounded-full border border-white/20"
        ></div>
      </aside>

      <div class="flex flex-col justify-center bg-white px-6 py-9 sm:px-10 md:px-14 md:py-12">
        <h1 class="text-center text-3xl font-bold text-brand-petroleum">
          Regístrate como estudiante
        </h1>
        <p class="mt-3 text-center text-sm leading-relaxed text-brand-gray">
          Completa tus datos para crear tu perfil UWork.
        </p>

        <form
          class="mx-auto mt-8 grid w-full max-w-md gap-4"
          data-register-form
        >
          <label class="grid gap-2 text-xs font-medium text-brand-petroleum">
            Nombre completo
            <Input
              name="nombre"
              placeholder="Tu nombre y apellido"
              autoComplete="name"
              required
            />
          </label>
          <label class="grid gap-2 text-xs font-medium text-brand-petroleum">
            Correo electrónico
            <Input
              name="email"
              type="email"
              placeholder="nombre@correo.com"
              autoComplete="email"
              required
            />
          </label>
          <label class="grid gap-2 text-xs font-medium text-brand-petroleum">
            Contraseña
            <Input
              name="password"
              type="password"
              placeholder="Crea una contraseña"
              autoComplete="new-password"
              required
            />
          </label>
          <label class="grid gap-2 text-xs font-medium text-brand-petroleum">
            Institución
            <Input
              name="institucion"
              placeholder="Universidad, instituto o CFT"
              autoComplete="organization"
              required
            />
          </label>
          <label class="grid gap-2 text-xs font-medium text-brand-petroleum">
            Carrera
            <Input name="carrera" placeholder="Tu carrera" required />
          </label>
          <Button
            type="submit"
            className="mt-2 w-full disabled:opacity-100"
            data-register-submit
          >
            <span data-register-label>Crear mi perfil</span>
            <LoaderCircle
              className="hidden size-4 animate-spin"
              aria-hidden="true"
              data-register-spinner
            />
            <Check
              className="hidden size-4"
              aria-hidden="true"
              data-register-check
            />
          </Button>
          <p
            class="min-h-5 text-center text-xs text-brand-petroleum"
            role="status"
            aria-live="polite"
            data-register-status
          ></p>
        </form>

        <p class="mt-5 text-center text-xs text-brand-gray">
          ¿Ya tienes una cuenta?{" "}
          <a
            class="font-semibold text-brand-petroleum underline underline-offset-4 hover:text-brand-gray"
            href={loginUrl}
          >
            Inicia sesión
          </a>
        </p>
      </div>
    </div>
  </section>
</AuthLayout>

<script>
  import "@/components/auth/register.js";
</script>
